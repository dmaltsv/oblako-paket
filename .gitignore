# Что НЕ едет в репозиторий установочного пакета.
#
# Этот файл — часть состава пакета (блок 6): он уезжает в маленький репозиторий
# вместе со скриптами и работает там с первого коммита. Пока пакет лежит внутри
# репозитория проекта, он же управляет папкой `Пакет/` и здесь — правила у
# папки одни, где бы она ни лежала.

# --- ключи -------------------------------------------------------------------
# Первая строка и самая важная. Без неё первый же `git` в папке пакета унёс бы
# в репозиторий ключ Deepgram и личный ключ доступа к серверу. `.env.example`
# под маску не попадает: он кончается не на `.env`.
.env
*.env

# --- состав команды ----------------------------------------------------------
# Таблица «подпись в Zoom -> имя человека» (`zoom_deepgram_merge.py`). Это
# персональные данные: имена сотрудников и их логины в Zoom. Состав у каждого
# руководителя свой, и в общий пакет он не едет ни одной строкой.
Имена.json

# --- рабочие папки -----------------------------------------------------------
# Сами папки едут в git (пустых папок git не хранит — их держит `.gitkeep`),
# содержимое — нет: там запись встречи, расшифровка и личные задачи людей.
Разборы/*
!Разборы/.gitkeep
Аудио/*
!Аудио/.gitkeep
Расшифровки/
# Черновик подготовки к встрече (скилл podgotovka): позиция человека по карте
# проектов до слова «запиши». В Библиотеку его кладёт `library.py put`; в
# пакет он не едет ни строкой.
Подготовка/
# Черновик повестки (скилл povestka) — то же правило.
Повестки/

# --- Библиотека --------------------------------------------------------------
# Клоны приватных репозиториев компании (карта проектов, транскрипты, сводки,
# подготовки, повестки). Это ЧУЖИЕ репозитории со своей историей: попав внутрь
# пакета, они уехали бы в него целиком и вторым слоем — с чужими коммитами и
# документами компании в общедоступной сборке.
/Библиотека/

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]

# --- папки скиллов клиентов --------------------------------------------------
# Их содержимое СОБИРАЕТСЯ (`python install_skills.py`), а не хранится: указатель
# несёт абсолютный путь ЭТОЙ машины и в чужой копии ведёт в никуда.
/.claude/
/.codex/

# --- ОС ----------------------------------------------------------------------
.DS_Store
Thumbs.db
