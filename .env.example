# Настройки установочного пакета Oblako.
#
# СКОПИРУЙ ЭТОТ ФАЙЛ РЯДОМ ПОД ИМЕНЕМ `.env` и заполни. Сам `.env` в git не
# едет (см. `.gitignore`), поэтому ключи с этой машины никуда не уезжают.
# Обычно копировать и заполнять его руками не нужно: это делает мастер
# установки — команда агенту «настрой пакет».
#
# Заполнить надо три строки: адрес сервера и два ключа. Адрес не секрет, но и
# не угадывается — его даёт владелец системы вместе с приглашением.

# Адрес сервера Oblako. Только https: ключ едет заголовком, и по открытому
# каналу его увидит любой посредник. Без завершающей косой черты.
OBLAKO_BASE_URL=

# Личный ключ доступа к серверу. Выдаёт кнопка «Ключ доступа» в настройках
# Mini App и показывает ОДИН раз; живой ключ у человека один — выдача нового
# отзывает прежний. Ключ даёт ровно три операции разбора планёрки и ничего
# больше: доступа к машине сервера у пакета нет.
OBLAKO_ACCESS_KEY=

# Ключ Deepgram — расшифровка записи встречи. У каждого руководителя СВОЙ,
# централизованной оплаты нет: https://console.deepgram.com → регистрация через
# Google или почту → слева «API Keys» → «Create a New API Key». Ключ
# показывается один раз. Стартового кредита хватает примерно на 190
# полуторачасовых встреч; одна встреча стоит около доллара, расход виден в том
# же кабинете.
DEEPGRAM_API_KEY=

# --- необязательное ----------------------------------------------------------

# Библиотека — приватные репозитории с документами компании (карта проектов,
# транскрипты, сводки, подготовки, повестки). Адреса через `;`; их даёт владелец
# системы вместе с приглашением в репозитории. Клоны заводит мастер установки в
# папку «Библиотека» рядом с командами.
#
# ТОКЕНОВ ЗДЕСЬ НЕ БЫВАЕТ. Доступ к GitHub даёт вход в браузере (`gh auth
# login`), а хранится он в хранилище системы — вписывать в адрес пароль или
# токен не нужно и нельзя.
#
# Не заполнено — разбор планёрки работает как прежде: Библиотека необязательна.
# OBLAKO_LIBRARY_URLS=https://github.com/dmaltsv/sovet.git;https://github.com/dmaltsv/biblioteka.git

# Где держать клоны Библиотеки, если не рядом с командами.
# OBLAKO_LIBRARY_DIR=C:\Users\я\Documents\Библиотека

# Где искать запись встречи, если её нет в папке разбора. Список папок через `;`.
# Не задан — смотрим в «Документы/Zoom» (туда пишет локальная запись Zoom),
# «Zoom» и «Загрузки» (туда падает скачанный из облака M4A).
# OBLAKO_AUDIO_DIRS=C:\Users\я\Documents\Zoom;C:\Users\я\Downloads

# Ключ Zoom — ТОЛЬКО если хочешь, чтобы помощник сам забирал запись из облака
# Zoom (`zoom_pull.py`). Те же три строки, что вписаны в настройках Oblako, из
# кабинета разработчика Zoom: приложение типа Server-to-Server OAuth, раздел
# App Credentials. Сверх прав на встречи ключу нужны два права на чтение
# записей — как их выдать, написано в файле «Записи Zoom — чтобы помощник
# забирал их сам.md» рядом. Не заполнены — разбор работает прежней дорогой:
# ссылку на файл открывает человек в браузере.
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
